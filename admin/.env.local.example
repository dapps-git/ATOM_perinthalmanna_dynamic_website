# ── Local Development ──────────────────────────────────────────────
# Copy this file to .env.local for local dev (git-ignored)
# Leave blank or set: VITE_API_URL=http://localhost:5000/api
# (admin auto-detects localhost and uses /api proxy if unset)

# ── Production (Vercel) ────────────────────────────────────────────
# Set in Vercel Dashboard → Project Settings → Environment Variables:
# VITE_API_URL = https://tweaki.pw/atom_institution/api

